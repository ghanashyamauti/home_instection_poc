# ===================================================
# Server & Environment Configuration
# ===================================================
PORT=3001
NODE_ENV=development

# ===================================================
# Database (PostgreSQL / Neon)
# ===================================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=false

# ===================================================
# OpenRouter AI Vision Configuration
# ===================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODELS_FALLBACK_CHAIN=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free

# ===================================================
# JWT & Authentication Security
# ===================================================
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# ===================================================
# CORS & Client Application URL
# ===================================================
CORS_ORIGIN=http://localhost:5173
APP_CLIENT_URL=http://localhost:5173

# ===================================================
# File Uploads
# ===================================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
